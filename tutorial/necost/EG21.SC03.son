necost {
    % EG21/SC03: Continuous Pu recycle in PWR (CORAIL-Pu)
    % Source: FCRD-FCO-2013-000196, Appendix A report input tables.
    % NE-COST input preparer: Edward Hoffman (ANL)
    % Technical Reviewer: Francesco Ganda (INL)
    % Fuel cycle option EG21/SC03 (Figure 71) Continuous Pu recycle in PWR (CORAIL-Pu) is a single state continuous recycle of Pu (MA sent to waste) in a pressurized water reactor using a single heterogeneous fuel assembly that consists of a mix of standard enriched uranium fuel pins and mixed oxide fuel pins.
    % Report LCAE at 3% discount rate: mean 45.0 mills/kWh, std 3.8 mills/kWh.
    % Report LCAE at 5% discount rate: mean 56.5 mills/kWh, std 5.6 mills/kWh.
    % Report LCAE at 10% discount rate: mean 94.4 mills/kWh, std 11.9 mills/kWh.

    construction_interest_rate = 0.05
    operations_interest_rate = 0.05
    sample_size = 2000

    legacy_inputs {
        case(EG21) {
            % Report LCAE weight for this input table.
            energy_fraction = 1
            input(1) {
                low = 3e+09
                nominal = 3e+09
                high = 3e+09
                distribution = 0
                description = "Reference core thermal power (W)"
            }
            input(2) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Core thermal power as a fraction of reference (1=100%)"
            }
            input(3) {
                low = 33
                nominal = 33
                high = 33
                distribution = 0
                description = "Thermal efficiency (%) (100=100%)"
            }
            input(4) {
                low = 89
                nominal = 89
                high = 89
                distribution = 0
                description = "Core HM mass direct spec. (in MT)"
            }
            input(11) {
                low = 45
                nominal = 45
                high = 45
                distribution = 0
                description = "Average discharge burnup (GWD/MTiHM)"
            }
            input(13) {
                low = 2300
                nominal = 4000
                high = 5800
                distribution = 1
                description = "Overnight capital cost ($/kWe)"
            }
            input(15) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 0
                description = "Discount rate (1=100%)"
            }
            input(16) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for front end costs (%/year) (1=100%)"
            }
            input(17) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for back end costs (%/year) (1=100%)"
            }
            input(18) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for O & M costs (%/year) (1=100%)"
            }
            input(19) {
                low = 5
                nominal = 5
                high = 5
                distribution = 0
                description = "Years for construction"
            }
            input(20) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 0
                description = "Annual interest rate during construction, compounded quarterly (1=100%)"
            }
            input(21) {
                low = 0.9
                nominal = 0.9
                high = 0.9
                distribution = 0
                description = "Direct specification of capacity factor (1=100%)"
            }
            input(27) {
                low = 58
                nominal = 70
                high = 84
                distribution = 1
                description = "Direct specification of fixed O&M costs [$/kWe-y]"
            }
            input(28) {
                low = 0.84
                nominal = 1.9
                high = 2.6
                distribution = 1
                description = "O&M variable cost (mills/kWh)"
            }
            input(33) {
                low = 4.62
                nominal = 4.62
                high = 4.62
                distribution = 0
                description = "Enrichment for fresh uranium fuel (%) (100=100%)"
            }
            input(34) {
                low = 0.711
                nominal = 0.711
                high = 0.711
                distribution = 0
                description = "Feed enrichment for fresh uranium fuel (%) (100=100%)"
            }
            input(35) {
                low = 0.25
                nominal = 0.25
                high = 0.25
                distribution = 0
                description = "Tails enrichment for fresh uranium fuel (%) (100=100%)"
            }
            input(36) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for purchase for fresh uranium fuel (y)"
            }
            input(37) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for conversion for fresh uranium fuel (y)"
            }
            input(38) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for enrichment for fresh uranium fuel (y)"
            }
            input(39) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for fabrication for fresh uranium fuel (y)"
            }
            input(40) {
                low = 65
                nominal = 110
                high = 230
                distribution = 1
                description = "Cost of U ($/kg_U)"
            }
            input(41) {
                low = 70
                nominal = 100
                high = 120
                distribution = 2
                description = "Cost of SWU ($/kg_SWU)"
            }
            input(42) {
                low = 200
                nominal = 350
                high = 500
                distribution = 1
                description = "Cost of Fuel Fabrication ($/kg_U)"
            }
            input(43) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Kg of extra fabrication material per kg of nominal HM"
            }
            input(44) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Added cost for fuel fabrication (normally zero, can be used to add burnable poisons, Th, other extra materials that have independent fuel cost distribution)"
            }
            input(45) {
                low = 6
                nominal = 12
                high = 18
                distribution = 2
                description = "Cost of Conversion ($/kg_U product as UF6)"
            }
            input(46) {
                low = 4
                nominal = 6
                high = 8
                distribution = 1
                description = "Cost of De-Conversion of depleted uranium ($/kg_U product as UF6)"
            }
            input(47) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Cost of off-site wet storage ($/kg_HM)"
            }
            input(48) {
                low = 50
                nominal = 100
                high = 130
                distribution = 1
                description = "Cost of SNF conditioning before shipping ($/kg_HM)"
            }
            input(49) {
                low = 0.2
                nominal = 0.2
                high = 0.2
                distribution = 0
                description = "Fabrication loss for fresh uranium fuel (%) (100=100%)"
            }
            input(50) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Conversion loss for fresh uranium fuel (%) (100=100%)"
            }
            input(51) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Losses at the reprocessing plant that accepts fuel from previous island (%) (100=100%)"
            }
            input(52) {
                low = 0.682
                nominal = 0.682
                high = 0.682
                distribution = 0
                description = "Fraction of the core loaded with natural uranium (to go the natural uranium enrichment route) (1=100%)"
            }
            input(53) {
                low = 0.318
                nominal = 0.318
                high = 0.318
                distribution = 0
                description = "Fraction of the core loaded with reprocessed material from the previous island (1=100%)"
            }
            input(61) {
                low = 1750
                nominal = 3500
                high = 6000
                distribution = 1
                description = "Cost of MOX fuel fabrication ($/kgHM)"
            }
            input(62) {
                low = 2200
                nominal = 5000
                high = 6600
                distribution = 1
                description = "Cost of FP conditioning before storage ($/kgFP)"
            }
            input(63) {
                low = 1377
                nominal = 5500
                high = 6880
                distribution = 1
                description = "Cost of FP to geologic repository ($/kgFP)"
            }
            input(64) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for reprocessing (y)"
            }
            input(65) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for re-fabrication (y)"
            }
            input(66) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for FP conditioning (y)"
            }
            input(67) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for FP disposal (y)"
            }
            input(75) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 1: Do nothing"
            }
            input(76) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 2: Geol. repository"
            }
            input(77) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 3: Dry storage + repository"
            }
            input(78) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 4: 1 mills/kWh -"
            }
            input(79) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 5: Reprocessing within the island"
            }
            input(82) {
                low = 755
                nominal = 925
                high = 1096
                distribution = 1
                description = "Specific cost of reprocessing/refabrication within the island ($/kgHM)"
            }
            input(83) {
                low = 0.06
                nominal = 0.06
                high = 0.06
                distribution = 0
                description = "Fraction of FP in fuel discharged/recycled from same island (1=100%)"
            }
            input(88) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Fraction of DU to be de-converted (the rest must be re-used) (1=100%)"
            }
            input(94) {
                low = 61
                nominal = 72
                high = 93
                distribution = 1
                description = "Cost of RU disposal ($/kgHM)"
            }
            input(95) {
                low = 0.885
                nominal = 0.885
                high = 0.885
                distribution = 0
                description = "Fraction of RU to be discarded (kg/kg of newly refabricated fuel) (1=100%)"
            }
            input(96) {
                low = 2
                nominal = 4
                high = 22
                distribution = 1
                description = "Cost of DU disposal ($/kgHM)"
            }
        }
    }
}
