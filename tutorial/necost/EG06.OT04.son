necost {
    % EG06/OT04 Thermal Spectrum FFH(Th) to DF
    % Source: FCRD-FCO-2013-000196, Appendix A report input tables.
    % NE-COST input preparer: Francesco Ganda (INL)
    % Technical Reviewer: Edward Hoffman (ANL)
    % Fuel cycle option EG06/OT04 (Figure 20) Thermal Spectrum FFH(Th) to DF is composed of a single stage: An inertial confinement fusion (ICF) system is used to produce thermal power and DT neutrons. A subcritical blanket surrounding the ICF system contains Thorium (Th) molten salt fuel, breeding and fissioning 233U at equilibrium, moderated by graphite to produce a thermal neutron spectrum.
    % This option is modeled using a single NE-COST island. The fuel procurement costs are computed using front-end path 1. The discharged fuel is than prepared for shipment and disposal and then disposed.
    % Report LCAE at 3% discount rate: mean 91.1 mills/kWh, std 13.3 mills/kWh.
    % Report LCAE at 5% discount rate: mean 115.1 mills/kWh, std 16.8 mills/kWh.
    % Report LCAE at 10% discount rate: mean 195.8 mills/kWh, std 31.2 mills/kWh.

    construction_interest_rate = 0.05
    operations_interest_rate = 0.05
    sample_size = 2000

    legacy_inputs {
        case(EG06) {
            % Report LCAE weight for this input table.
            energy_fraction = 1
            input(1) {
                low = 1.94e+09
                nominal = 1.94e+09
                high = 1.94e+09
                distribution = 0
                description = "Reference core thermal power (W)"
            }
            input(2) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Core thermal power as a fraction of reference (1=100%)"
            }
            input(3) {
                low = 45.79
                nominal = 45.79
                high = 45.79
                distribution = 0
                description = "Thermal efficiency (%) (100=100%)"
            }
            input(4) {
                low = 19.9
                nominal = 19.9
                high = 19.9
                distribution = 0
                description = "Direct specification of core HM mass (MTiHM)."
            }
            input(11) {
                low = 117.71
                nominal = 117.71
                high = 117.71
                distribution = 0
                description = "Average discharge burnup (GWD/MTiHM)"
            }
            input(13) {
                low = 4783
                nominal = 9371
                high = 13689
                distribution = 1
                description = "Overnight reactor capital cost ($/kWe)"
            }
            input(15) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 0
                description = "Discount rate (1=100%)"
            }
            input(19) {
                low = 5
                nominal = 5
                high = 5
                distribution = 0
                description = "Years for reactor construction"
            }
            input(20) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 1
                description = "Annual interest rate during construction, compounded quarterly (1=100%)"
            }
            input(21) {
                low = 0.9
                nominal = 0.9
                high = 0.9
                distribution = 0
                description = "Direct specification of capacity factor (1=100%)"
            }
            input(27) {
                low = 129
                nominal = 311
                high = 516
                distribution = 1
                description = "Direct specification of fixed O&M costs [$/kWe-y]"
            }
            input(28) {
                low = 3
                nominal = 6
                high = 8.1
                distribution = 1
                description = "O&M variable cost (mills/kWh)"
            }
            input(42) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Cost of Fuel Fabrication ($/kg of enriched U)"
            }
            input(43) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Kg of extra fab material per kg of nominal HM"
            }
            input(44) {
                low = 45
                nominal = 75
                high = 155
                distribution = 0
                description = "Added cost for fuel fabrication (normally zero, can be used to add burnable poisons, Th, other extra materials that have independent fuel cost distribution)"
            }
            input(48) {
                low = 50
                nominal = 100
                high = 130
                distribution = 1
                description = "Cost of SNF conditioning before shipping ($/kg_HM)"
            }
            input(49) {
                low = 0.2
                nominal = 0.2
                high = 0.2
                distribution = 0
                description = "Fabrication loss for fresh uranium fuel (%) (100=100%)"
            }
            input(52) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Fraction of the core loaded with natural/enriched uranium (1=100%)"
            }
            input(76) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 2: Geol. disposal"
            }
            input(81) {
                low = 265
                nominal = 550
                high = 801
                distribution = 1
                description = "Specific cost of SNF geologic disposal ($/kgHM)"
            }
        }
    }
}
