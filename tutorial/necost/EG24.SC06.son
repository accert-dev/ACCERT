necost {
    % EG24/SC06: Continuous TRU recycle in SFR
    % Source: FCRD-FCO-2013-000196, Appendix A report input tables.
    % NE-COST input preparer: Edward Hoffman (ANL)
    % Technical Reviewer: Francesco Ganda (INL)
    % Fuel cycle option EG24/SC06 (Figure 80) SFR for continuous recycling is a single state continuous recycle of all transuranics in a sodium-cooled metal-fueled breeder fast reactor.
    % Report LCAE at 3% discount rate: mean 43.2 mills/kWh, std 5.3 mills/kWh.
    % Report LCAE at 5% discount rate: mean 55.5 mills/kWh, std 7.9 mills/kWh.
    % Report LCAE at 10% discount rate: mean 96.5 mills/kWh, std 16.7 mills/kWh.

    construction_interest_rate = 0.05
    operations_interest_rate = 0.05
    sample_size = 2000

    legacy_inputs {
        case(EG24) {
            % Report LCAE weight for this input table.
            energy_fraction = 1
            input(1) {
                low = 1e+09
                nominal = 1e+09
                high = 1e+09
                distribution = 0
                description = "Reference core thermal power (W)"
            }
            input(2) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Core thermal power as a fraction of reference (1=100%)"
            }
            input(3) {
                low = 40
                nominal = 40
                high = 40
                distribution = 0
                description = "Thermal efficiency (%) (100=100%)"
            }
            input(4) {
                low = 16.7
                nominal = 16.7
                high = 16.7
                distribution = 0
                description = "Core HM mass direct spec. (in MT)"
            }
            input(11) {
                low = 73
                nominal = 73
                high = 73
                distribution = 0
                description = "Average discharge burnup (GWD/MTiHM)"
            }
            input(13) {
                low = 2200
                nominal = 3000
                high = 7000
                distribution = 1
                description = "Overnight capital cost ($/kWe)"
            }
            input(15) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 0
                description = "Discount rate (1=100%)"
            }
            input(16) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for front end costs (%/year) (1=100%)"
            }
            input(17) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for back end costs (%/year) (1=100%)"
            }
            input(18) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for O & M costs (%/year) (1=100%)"
            }
            input(19) {
                low = 5
                nominal = 5
                high = 5
                distribution = 0
                description = "Years for construction"
            }
            input(20) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 0
                description = "Annual interest rate during construction, compounded quarterly (1=100%)"
            }
            input(21) {
                low = 0.9
                nominal = 0.9
                high = 0.9
                distribution = 0
                description = "Direct specification of capacity factor (1=100%)"
            }
            input(27) {
                low = 60
                nominal = 70
                high = 85
                distribution = 1
                description = "Direct specification of fixed O&M costs [$/kWe-y]"
            }
            input(28) {
                low = 1
                nominal = 2
                high = 2.7
                distribution = 1
                description = "O&M variable cost (mills/kWh)"
            }
            input(33) {
                low = 0.711
                nominal = 0.711
                high = 0.711
                distribution = 0
                description = "Enrichment for fresh uranium fuel (% U-235) (100=100%)"
            }
            input(34) {
                low = 0.711
                nominal = 0.711
                high = 0.711
                distribution = 0
                description = "Feed enrichment for fresh uranium fuel (% U-235) (100=100%)"
            }
            input(36) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for purchase for fresh uranium fuel (y)"
            }
            input(37) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for conversion for fresh uranium fuel (y)"
            }
            input(38) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for enrichment for fresh uranium fuel (y)"
            }
            input(39) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for fabrication for fresh uranium fuel (y)"
            }
            input(40) {
                low = 65
                nominal = 110
                high = 230
                distribution = 1
                description = "Cost of U ($/kg_U)"
            }
            input(41) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Cost of SWU ($/kg_SWU)"
            }
            input(43) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Kg of extra fabrication material per kg of nominal HM"
            }
            input(44) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Added cost for fuel fabrication (normally zero, can be used to add burnable poisons, Th, other extra materials that have independent fuel cost distribution)"
            }
            input(45) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Cost of Conversion ($/kg_U product as UF6)"
            }
            input(46) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Cost of De-Conversion of depleted uranium ($/kg_U product as UF6)"
            }
            input(47) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Cost of off-site wet storage ($/kg_HM)"
            }
            input(48) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Cost of SNF conditioning before shipping ($/kg_HM)"
            }
            input(49) {
                low = 0.2
                nominal = 0.2
                high = 0.2
                distribution = 0
                description = "Fabrication loss for fresh uranium fuel (%) (100=100%)"
            }
            input(50) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Conversion loss for fresh uranium fuel (%) (100=100%)"
            }
            input(51) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Losses at the reprocessing plant (%) (100=100%)"
            }
            input(52) {
                low = 0.09
                nominal = 0.09
                high = 0.09
                distribution = 0
                description = "Fraction of the core loaded with natural uranium (to go the natural uranium enrichment route) (1=100%)"
            }
            input(62) {
                low = 2200
                nominal = 5000
                high = 6600
                distribution = 1
                description = "Cost of FP conditioning before storage ($/kgFP)"
            }
            input(63) {
                low = 1377
                nominal = 5500
                high = 6880
                distribution = 1
                description = "Cost of FP to geologic repository ($/kgFP)"
            }
            input(64) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for reprocessing (y)"
            }
            input(65) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for re-fabrication (y)"
            }
            input(66) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for FP conditioning (y)"
            }
            input(67) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for FP disposal (y)"
            }
            input(75) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 1: Do nothing"
            }
            input(76) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 2: Geol. repository"
            }
            input(77) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 3: Dry storage + repository"
            }
            input(78) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 4: 1 mills/kWh -"
            }
            input(79) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 5: Reprocessing within the island"
            }
            input(82) {
                low = 3000
                nominal = 6000
                high = 9000
                distribution = 1
                description = "Specific cost of reprocessing/refabrication within the island ($/kgHM)"
            }
            input(83) {
                low = 0.088
                nominal = 0.088
                high = 0.088
                distribution = 0
                description = "Fraction of FP in fuel discharged/recycled from same island (1=100%)"
            }
        }
    }
}
