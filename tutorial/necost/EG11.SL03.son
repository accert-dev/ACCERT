necost {
    % EG11/SL03 - Thorium Breed and Burn with LEU Support in SFR with Partial Separation
    % Source: FCRD-FCO-2013-000196, Appendix A report input tables.
    % NE-COST input preparer: Francesco Ganda (INL)
    % Technical Reviewer: Ed Hoffman (ANL)
    % In fuel cycle option EG11/SL03 (Figure 30) Thorium Breed and Burn with LEU Support in SFR with Partial Separation a Breed and Burn (B&B) SFR is continuously fed with metal thorium (232Th) and some LEU metal fuel. The thorium-based fuel is reconditioned three times and stays in the core for seven cycles. It is then discharged and sent to a repository. The LEU fuel resides in the core for a single cycle and is sent to a repository. The core is made of 8 fuel batches (7 are thorium based, one is LEU) and operates with a fissile conversion ratio (CR) slightly below unity. One fuel batch is made of 19.9% LEU, which is replaced every cycle. The seven other batches are made of U3/Th fuel.
    % Report LCAE at 3% discount rate: mean 45.6 mills/kWh, std 5.0 mills/kWh.
    % Report LCAE at 5% discount rate: mean 59.3 mills/kWh, std 7.6 mills/kWh.
    % Report LCAE at 10% discount rate: mean 105.3 mills/kWh, std 16.5 mills/kWh.

    construction_interest_rate = 0.05
    operations_interest_rate = 0.05
    sample_size = 2000

    legacy_inputs {
        case(EG11) {
            % Report LCAE weight for this input table.
            energy_fraction = 1
            input(1) {
                low = 3e+09
                nominal = 3e+09
                high = 3e+09
                distribution = 0
                description = "Reference core thermal power (W)"
            }
            input(2) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Core thermal power as a fraction of reference (1=100%)"
            }
            input(3) {
                low = 40
                nominal = 40
                high = 40
                distribution = 0
                description = "Thermal efficiency (%) (100=100%)"
            }
            input(4) {
                low = 84.7
                nominal = 84.7
                high = 84.7
                distribution = 0
                description = "Direct specification of core HM mass (MTiHM)."
            }
            input(11) {
                low = 380
                nominal = 380
                high = 380
                distribution = 0
                description = "Average discharge burnup (GWD/MTiHM)"
            }
            input(12) {
                low = 7
                nominal = 7
                high = 7
                distribution = 0
                description = "# of batches"
            }
            input(13) {
                low = 2200
                nominal = 3800
                high = 7000
                distribution = 1
                description = "Overnight reactor capital cost ($/kWe)"
            }
            input(15) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 0
                description = "Discount rate (1=100%)"
            }
            input(16) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for front end costs (%/year) (1=100%)"
            }
            input(17) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for back end costs (%/year) (1=100%)"
            }
            input(18) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for reactor O & M costs (%/year) (1=100%)"
            }
            input(19) {
                low = 5
                nominal = 5
                high = 5
                distribution = 0
                description = "Years for reactor construction"
            }
            input(20) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 0
                description = "Annual interest rate during construction, compounded quarterly (1=100%)"
            }
            input(21) {
                low = 0.9
                nominal = 0.9
                high = 0.9
                distribution = 0
                description = "Direct specification of reactor capacity factor (1=100%)"
            }
            input(27) {
                low = 60
                nominal = 70
                high = 85
                distribution = 1
                description = "Direct specification of reactor fixed O&M costs [$/kWe-y]"
            }
            input(28) {
                low = 1
                nominal = 2
                high = 2.7
                distribution = 1
                description = "Reactor O&M variable cost (mills/kWh)"
            }
            input(33) {
                low = 19.9
                nominal = 19.9
                high = 19.9
                distribution = 0
                description = "Enrichment for fresh uranium fuel (% U-235) (100=100%)"
            }
            input(34) {
                low = 0.711
                nominal = 0.711
                high = 0.711
                distribution = 0
                description = "Feed enrichment for fresh uranium fuel (% U-235) (100=100%)"
            }
            input(35) {
                low = 0.25
                nominal = 0.25
                high = 0.25
                distribution = 0
                description = "Tails enrichment for fresh uranium fuel (% U-235) (100=100%)"
            }
            input(36) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for purchase for fresh uranium fuel (y)"
            }
            input(37) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for conversion for fresh uranium fuel (y)"
            }
            input(38) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for enrichment for fresh uranium fuel (y)"
            }
            input(39) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for fabrication for fresh uranium fuel (y)"
            }
            input(40) {
                low = 65
                nominal = 110
                high = 230
                distribution = 1
                description = "Cost of U3O8 ($/kgU as Uranium ore concentrate)"
            }
            input(41) {
                low = 70
                nominal = 100
                high = 120
                distribution = 2
                description = "Cost of SWU ($/kg_SWU)"
            }
            input(42) {
                low = 475
                nominal = 825
                high = 1180
                distribution = 1
                description = "Cost of LEU Fuel Fabrication ($/kg of enriched U)"
            }
            input(43) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Kg of extra fab material per kg of nominal HM"
            }
            input(44) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Added cost for fuel fabrication"
            }
            input(45) {
                low = 6
                nominal = 12
                high = 18
                distribution = 2
                description = "Cost of Conversion ($/kg_U product as UF6)"
            }
            input(46) {
                low = 4
                nominal = 6
                high = 8
                distribution = 1
                description = "Cost of De-Conversion of depleted uranium hexafluoride ($/kgDU as DU3O8 product)"
            }
            input(47) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Cost of off-site wet storage ($/kg_HM)"
            }
            input(48) {
                low = 50
                nominal = 100
                high = 130
                distribution = 1
                description = "Cost of SNF conditioning before shipping ($/kg_HM)"
            }
            input(49) {
                low = 0.2
                nominal = 0.2
                high = 0.2
                distribution = 0
                description = "Fabrication loss for fresh uranium fuel (%) (100=100%)"
            }
            input(50) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Conversion loss for fresh uranium fuel (%) (100=100%)"
            }
            input(51) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Losses at the reprocessing plant that accepts fuel from previous island (%) (100=100%)"
            }
            input(52) {
                low = 1.45
                nominal = 1.45
                high = 1.45
                distribution = 0
                description = "Fraction of the core loaded with natural/enriched uranium (1=100%)"
            }
            input(53) {
                low = 1.19
                nominal = 1.19
                high = 1.19
                distribution = 0
                description = "Fraction of the core loaded with reprocessed material(1=100%)"
            }
            input(60) {
                low = 0
                nominal = 0
                high = 0
                distribution = 1
                description = "Cost of reprocessing ($/kgHM)"
            }
            input(61) {
                low = 250
                nominal = 450
                high = 630
                distribution = 1
                description = "Cost of fabrication of reprocessed fuel ($/kgHM)"
            }
            input(62) {
                low = 2200
                nominal = 5000
                high = 6600
                distribution = 1
                description = "Cost of FP conditioning before storage/disposal ($/kgFP)"
            }
            input(63) {
                low = 1377
                nominal = 5500
                high = 6880
                distribution = 1
                description = "Cost of FP geologic disposal ($/kgFP)"
            }
            input(65) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for fabrication of Th blanket (y)"
            }
            input(75) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 1: Do nothing"
            }
            input(76) {
                low = 2.64
                nominal = 2.64
                high = 2.64
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 2: Geol. disposal"
            }
            input(77) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 3: Dry storage + Geol. disposal"
            }
            input(78) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 4: 1 mills/kWh"
            }
            input(79) {
                low = 3
                nominal = 3
                high = 3
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 5: Reprocessing within the island"
            }
            input(80) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Specific cost of SNF dry storage ($/kgHM)"
            }
            input(81) {
                low = 265
                nominal = 550
                high = 801
                distribution = 1
                description = "Specific cost of SNF geologic disposal ($/kgHM)"
            }
            input(82) {
                low = 3000
                nominal = 6000
                high = 9000
                distribution = 1
                description = "Specific cost of reprocessing/refabrication within the island ($/kgHM)"
            }
            input(83) {
                low = 0.069
                nominal = 0.069
                high = 0.069
                distribution = 0
                description = "Fraction of FP in fuel discharged/recycled (1=100%)"
            }
            input(88) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Fraction of DU to be de-converted (the rest must be re-used) (1=100%)"
            }
            input(89) {
                low = 45
                nominal = 75
                high = 155
                distribution = 1
                description = "Cost of Th as make-up for reprocessed fuel (line 60) ($/kgHM)"
            }
            input(90) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Fraction of NU (kg/kg of new fuel) in newly refabricated fuel after reprocessing (line 60) (1=100%)"
            }
            input(91) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Fraction of DU (kg/kg of new fuel) in newly refabricated fuel after reprocessing (line 60) (1=100%)"
            }
            input(92) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Fraction of Th (kg/kg of new fuel) in newly refabricated fuel after reprocessing (line 60) (1=100%)"
            }
        }
    }
}
