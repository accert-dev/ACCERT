                distribution = 0
                description = "Escalation rate for O & M costs (%/year) (1=100%)"
            }
            input(19) {
                low = 5
                nominal = 5
                high = 5
                distribution = 0
                description = "Years for construction"
            }
            input(20) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 0
                description = "Annual interest rate during construction, compounded quarterly (1=100%)"
            }
            input(21) {
                low = 0.9
                nominal = 0.9
                high = 0.9
                distribution = 0
                description = "Direct specification of L (capacity factor (1=100)"
            }
            input(27) {
                low = 60
                nominal = 70
                high = 85
                distribution = 1
                description = "Direct specification of O&M costs [$/kWe-y]"
            }
            input(28) {
                low = 1
                nominal = 2
                high = 2.7
                distribution = 1
                description = "O&M fixed cost (mills/kWh);"
            }
