                high = 7000
                distribution = 1
                description = "Overnight capital cost ($/kWe)"
            }
            input(15) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 0
                description = "Discount rate (1=100%)"
            }
            input(16) {
                low = 0
