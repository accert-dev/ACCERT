necost {
    % EG26/SC08 - U-233 recycle in MSR
    % Source: FCRD-FCO-2013-000196, Appendix A report input tables.
    % NE-COST input preparer: Francesco Ganda (INL)
    % Technical Reviewer: Kent Williams (Consultant)
    % In fuel cycle option EG26/SC08 (Figure 87) U-233 recycle in MSR, a molten salt reactor (MSR) is used to irradiate fuel salt containing thorium (Th). Fuel salt containing thorium (Th) is irradiated in a molten salt reactor (MSR), using enriched uranium for initial startup. The fuel salt undergoes continuous online treatment to remove various fission products (FP) that would otherwise not stay in solution and also undergoes continuous chemical separations processing to further remove fission products. Protactinium (Pa) is allowed to decay outside of the reactor to optimize U-233 production. Recovered Th, uranium (RU), and transuranics (TRU) are returned to Stage 1 along with remnants of fission products (FP). Separated FP are stored and then sent for disposal.
    % This option is modeled using a single NE-COST island. Because of the characteristics of this fuel cycle option, a few changes had to be made to the standard NE-COST modeling techniques. One important consideration is that the fuel in this core does not reach a burnup in the traditional sense, and similarly does not have a cycle length. This requires a change to the standard approach of NE-COST, which uses the burnup and the core HM mass and specific power density to obtain a cycle length, which is normally then used by NE-COST as a sort of internal clock to time all the fuel cycle expenditures. However, it is still possible to use NE-COST to calculate the correct LCAE, by using the NE-COST input fields of burnup and number of batches cleverly to obtain an equivalent annual cycle and HM mass flow, which allows the code to compute the correct annual purchases of fuel cycle services (i.e. the purchases of make-up Th and disposal of HLW) as fraction of this arbitrary annual mass flow. Any value for the annual HM can be chosen, as long as the Th and HLW disposal masses match the correct annual value in [Ref 1]. The unusual modeling approaches adopted for this option are explained further in the bullet points in the next paragraph.
    % Report LCAE at 3% discount rate: mean 71.3 mills/kWh, std 11.8 mills/kWh.
    % Report LCAE at 5% discount rate: mean 86.7 mills/kWh, std 14.2 mills/kWh.
    % Report LCAE at 10% discount rate: mean 138.3 mills/kWh, std 24.7 mills/kWh.

    construction_interest_rate = 0.05
    operations_interest_rate = 0.05
    sample_size = 2000

    legacy_inputs {
        case(EG26) {
            % Report LCAE weight for this input table.
            energy_fraction = 1
            input(1) {
                low = 2.25e+09
                nominal = 2.25e+09
                high = 2.25e+09
                distribution = 0
                description = "Reference core thermal power (W)"
            }
            input(2) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Core thermal power as a fraction of reference (1=100%)"
            }
            input(3) {
                low = 44.4
                nominal = 44.4
                high = 44.4
                distribution = 0
                description = "Thermal efficiency (%) (100=100%)"
            }
            input(4) {
                low = 70.98
                nominal = 70.98
                high = 70.98
                distribution = 0
                description = "Direct specification of core HM mass (MTiHM)."
            }
            input(11) {
                low = 10.4
                nominal = 10.4
                high = 10.4
                distribution = 0
                description = "Average discharge burnup (GWD/MTiHM)"
            }
            input(12) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "# of batches"
            }
            input(13) {
                low = 2500
                nominal = 5800
                high = 9300
                distribution = 1
                description = "Overnight reactor capital cost ($/kWe)"
            }
            input(15) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 0
                description = "Discount rate (1=100%)"
            }
            input(16) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for front end costs (%/year) (1=100%)"
            }
            input(17) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for back end costs (%/year) (1=100%)"
            }
            input(18) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for reactor O & M costs (%/year) (1=100%)"
            }
            input(19) {
                low = 5
                nominal = 5
                high = 5
                distribution = 0
                description = "Years for reactor construction"
            }
            input(20) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 0
                description = "Annual interest rate during construction, compounded quarterly (1=100%)"
            }
            input(21) {
                low = 0.9
                nominal = 0.9
                high = 0.9
                distribution = 0
                description = "Direct specification of reactor capacity factor (1=100%)"
            }
            input(27) {
                low = 110
                nominal = 284
                high = 486
                distribution = 1
                description = "Direct specification of reactor fixed O&M costs [$/kWe-y]"
            }
            input(28) {
                low = 2
                nominal = 4
                high = 5.4
                distribution = 1
                description = "Reactor O&M variable cost (mills/kWh)"
            }
            input(52) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Fraction of the core loaded with natural/enriched uranium (1=100%)"
            }
            input(53) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Fraction of the core loaded with reprocessed material from the previous island (1=100%)"
            }
            input(59) {
                low = 0.0131
                nominal = 0.0131
                high = 0.0131
                distribution = 0
                description = "The amount of HLW to be disposed (1=100%)"
            }
            input(60) {
                low = 0
                nominal = 0
                high = 0
                distribution = 1
                description = "Cost of reprocessing ($/kgHM)"
            }
            input(61) {
                low = 0
                nominal = 0
                high = 0
                distribution = 1
                description = "Cost of fabrication of reprocessed fuel ($/kgHM)"
            }
            input(62) {
                low = 2200
                nominal = 5000
                high = 6600
                distribution = 1
                description = "Cost of FP conditioning before storage/disposal ($/kgFP)"
            }
            input(63) {
                low = 1377
                nominal = 5500
                high = 6880
                distribution = 1
                description = "Cost of FP geologic disposal ($/kgFP)"
            }
            input(64) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Lead time for reprocessing (y)"
            }
            input(65) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Lead time for re-fabrication (y)"
            }
            input(66) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for FP conditioning (y)"
            }
            input(67) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for FP disposal (y)"
            }
            input(75) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 1: Do nothing"
            }
            input(76) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 2: Geol. disposal"
            }
            input(77) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 3: Dry storage + Geol. disposal"
            }
            input(78) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 4: 1 mills/kWh"
            }
            input(79) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 5: Reprocessing within the island"
            }
            input(80) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Specific cost of SNF dry storage ($/kgHM)"
            }
            input(87) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Lead time for dry-storage (y)"
            }
            input(88) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Fraction of DU to be de-converted (the rest must be re-used) (1=100%)"
            }
            input(89) {
                low = 45
                nominal = 75
                high = 155
                distribution = 1
                description = "Cost of Th as make-up for reprocessed fuel (line 60) ($/kgHM)"
            }
            input(90) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Fraction of NU (kg/kg of new fuel) in newly refab fuel after reprocessing (line 60) (1=100%)"
            }
            input(91) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Fraction of DU (kg/kg of new fuel) in newly refab fuel after reprocessing (line 60) (1=100%)"
            }
            input(92) {
                low = 0.0131
                nominal = 0.0131
                high = 0.0131
                distribution = 0
                description = "Fraction of make-up Th (kg/kg of new fuel) in newly refab fuel after reprocessing (line 60) (1=100%)"
            }
            input(95) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Fraction of RU to be discarded (kg/kg of newly refabricated fuel) (1=100%)"
            }
        }
    }
}
