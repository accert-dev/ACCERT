                high = 0.0578
                distribution = 0
                description = "Fraction of FP (and MA or other TRU if lumped) in fuel discharged/recycled from same island (1=100%)"
            }
            input(95) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Fraction of RU to be discarded (kg/kg of newly refabricated fuel) (1=100%)"
            }
