                high = 1
                distribution = 0
                description = "Losses at the reprocessing plant (%) (100=100%)"
            }
            input(52) {
                low = 0.682
                nominal = 0.682
                high = 0.682
                distribution = 0
                description = "Fraction of the core loaded with natural uranium (to go the natural uranium enrichment route) (1=100%)"
            }
            input(53) {
                low = 0.318
                nominal = 0.318
                high = 0.318
                distribution = 0
                description = "Fraction of the core loaded with reprocessed material from the previous island (1=100%)"
            }
            input(61) {
                low = 1750
                nominal = 3500
                high = 6000
                distribution = 1
                description = "Cost of MOX fuel fabrication ($/kgHM)"
            }
            input(62) {
                low = 2200
                nominal = 5000
                high = 6600
                distribution = 1
                description = "Cost of FP conditioning before storage ($/kgFP)"
            }
            input(63) {
                low = 1377
                nominal = 5500
                high = 6880
                distribution = 1
                description = "Cost of FP to geologic repository ($/kgFP)"
            }
            input(64) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for reprocessing (y)"
            }
            input(65) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
