                high = 2
                distribution = 0
                description = "Lead time for FP disposal (y)"
            }
            input(79) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 5: Reprocessing within the island"
            }
            input(82) {
                low = 1040
                nominal = 1300
                high = 1558
                distribution = 1
                description = "Specific cost of reprocessing/refabrication within the island ($/kgHM)"
            }
            input(83) {
                low = 0.056
                nominal = 0.056
                high = 0.056
                distribution = 0
                description = "Fraction of FP in fuel discharged/recycled from same island (1=100%)"
            }
            input(88) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Fraction of DU to be de-converted (the rest must be re-used) (1=100%)"
            }
            input(94) {
                low = 61
                nominal = 72
                high = 93
                distribution = 1
                description = "Cost of RU disposal ($/kgHM)"
            }
            input(95) {
                low = 0.8849
                nominal = 0.8849
                high = 0.8849
                distribution = 0
                description = "Fraction of RU to be discarded (kg/kg of newly refabricated fuel) (1=100%)"
            }
            input(96) {
                low = 2
                nominal = 4
                high = 22
                distribution = 1
                description = "Cost of DU disposal ($/kgHM)"
            }
        }
        case(EG36_ISLAND_2) {
            % Report LCAE weight for this input table.
            energy_fraction = 0.065
            input(1) {
                low = 8.4e+08
                nominal = 8.4e+08
                high = 8.4e+08
                distribution = 0
                description = "Reference core thermal power (W)"
            }
            input(2) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Core thermal power as a fraction of reference (1=100%)"
            }
            input(3) {
                low = 34.5
                nominal = 34.5
                high = 34.5
                distribution = 0
                description = "Thermal efficiency (%) (100=100%)"
            }
            input(4) {
                low = 5.1
                nominal = 5.1
                high = 5.1
                distribution = 0
                description = "Direct specification of core HM mass (MTiHM)."
            }
            input(11) {
                low = 172
                nominal = 172
                high = 172
                distribution = 0
                description = "Average discharge burnup (GWD/MTiHM)"
            }
            input(13) {
                low = 5894
