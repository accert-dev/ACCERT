            }
            input(61) {
                low = 2097
                nominal = 4880
                high = 7661
                distribution = 1
                description = "Cost of fabrication of reprocessed fuel ($/kgHM)"
            }
            input(62) {
                low = 2200
                nominal = 5000
                high = 6600
                distribution = 1
                description = "Cost of FP conditioning before storage/disposal ($/kgFP)"
            }
            input(63) {
                low = 1377
                nominal = 5500
                high = 6880
                distribution = 1
                description = "Cost of FP geologic disposal ($/kgFP)"
            }
            input(64) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for reprocessing (y)"
            }
            input(65) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for re-fabrication (y)"
            }
            input(66) {
                low = 2
