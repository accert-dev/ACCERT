necost {
    % EG07/OT05 - ADS(NU) to DF
    % Source: FCRD-FCO-2013-000196, Appendix A report input tables.
    % NE-COST input preparer: Francesco Ganda (INL)
    % Technical Reviewer: Kent Williams (Consultant)
    % In fuel cycle option EG07/OT05 (Figure 22) ADS(NU) to DF, NU metal fuel is irradiated in a blanket zone of an ADS. In this case the blanket is assumed to be similar in design to the breed and burn SFR blanket. The target material is liquid lead, which acts as both the spallation neutron source and the heat removal medium. Initially a total of 200 MW of accelerator power is required to start building up the inventory of fissile material in the blanket volumes. However, after reaching equilibrium operations, the cycle duration is 2 years and the fuel assemblies are shuffled three times, thus the fuel assemblies reside in the blanket for a total of 6 years. Following exposure the fuel assemblies are discharged and stored as waste. The average thermal power for all four blankets is 1000 MW, or 250 MW per blanket unit. The average total accelerator beam power (for four units) is 61.5 MW, which requires approximately a total of 123 MW (assuming a 50% efficiency) of wall power, and the minimum keff reached during the equilibrium cycles is 0.8626, requiring a beam power of 138 MW. Assuming a power conversion system thermal efficiency of 40% the average electrical power generated by the blanket assemblies is 400 MW. Thus, subtracting the average power required for the accelerator leaves a net electrical output of 277 MW.
    % This option is modeled using a single NE-COST island. It is noted that particular care has to be taken in this system in assessing an accurate specific capital cost for the accelerator and for the subcritical system. The methodology to identify those values is explained below.
    % Report LCAE at 3% discount rate: mean 556.4 mills/kWh, std 169.6 mills/kWh.
    % Report LCAE at 5% discount rate: mean 827.6 mills/kWh, std 260.9 mills/kWh.
    % Report LCAE at 10% discount rate: mean 1742.8 mills/kWh, std 568.6 mills/kWh.

    construction_interest_rate = 0.05
    operations_interest_rate = 0.05
    sample_size = 2000

    legacy_inputs {
        case(EG07) {
            % Report LCAE weight for this input table.
            energy_fraction = 1
            input(1) {
                low = 1e+09
                nominal = 1e+09
                high = 1e+09
                distribution = 0
                description = "Reference core thermal power (W)"
            }
            input(2) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Core thermal power as a fraction of reference (1=100%)"
            }
            input(3) {
                low = 27.7
                nominal = 27.7
                high = 27.7
                distribution = 0
                description = "Thermal efficiency (%) (100=100%)"
            }
            input(4) {
                low = 40
                nominal = 40
                high = 40
                distribution = 0
                description = "Direct specification of core HM mass (MTiHM)."
            }
            input(11) {
                low = 55
                nominal = 55
                high = 55
                distribution = 0
                description = "Average discharge burnup (GWD/MTiHM)"
            }
            input(13) {
                low = 21699
                nominal = 95881
                high = 189721
                distribution = 1
                description = "Overnight reactor capital cost ($/kWe)"
            }
            input(15) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 0
                description = "Discount rate (1=100%)"
            }
            input(16) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for front end costs (%/year) (1=100%)"
            }
            input(17) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for back end costs (%/year) (1=100%)"
            }
            input(18) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for reactor O & M costs (%/year) (1=100%)"
            }
            input(19) {
                low = 5
                nominal = 5
                high = 5
                distribution = 0
                description = "Years for reactor construction"
            }
            input(20) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 0
                description = "Annual interest rate during construction, compounded quarterly (1=100%)"
            }
            input(21) {
                low = 0.9
                nominal = 0.9
                high = 0.9
                distribution = 0
                description = "Direct specification of reactor capacity factor (1=100%)"
            }
            input(27) {
                low = 146
                nominal = 376
                high = 644
                distribution = 1
                description = "Direct specification of reactor fixed O&M costs [$/kWe-y]"
            }
            input(28) {
                low = 3.8
                nominal = 7.6
                high = 10.3
                distribution = 1
                description = "Reactor O&M variable cost (mills/kWh)"
            }
            input(33) {
                low = 0.711
                nominal = 0.711
                high = 0.711
                distribution = 0
                description = "Enrichment for fresh uranium fuel (% U-235) (100=100%)"
            }
            input(34) {
                low = 0.711
                nominal = 0.711
                high = 0.711
                distribution = 0
                description = "Feed enrichment for fresh uranium fuel (% U-235) (100=100%)"
            }
            input(35) {
                low = 0.25
                nominal = 0.25
                high = 0.25
                distribution = 0
                description = "Tails enrichment for fresh uranium fuel (% U-235) (100=100%)"
            }
            input(36) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for purchase for fresh uranium fuel (y)"
            }
            input(37) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Lead time for conversion for fresh uranium fuel (y)"
            }
            input(38) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Lead time for enrichment for fresh uranium fuel (y)"
            }
            input(39) {
                low = 2
                nominal = 2
                high = 2
                distribution = 0
                description = "Lead time for fabrication for fresh uranium fuel (y)"
            }
            input(40) {
                low = 65
                nominal = 110
                high = 230
                distribution = 1
                description = "Cost of U3O8 ($/kgU as Uranium ore concentrate)"
            }
            input(41) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Cost of SWU ($/kg_SWU)"
            }
            input(42) {
                low = 250
                nominal = 450
                high = 630
                distribution = 1
                description = "Cost of Fuel Fabrication ($/kg of enriched U)"
            }
            input(43) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Kg of extra fab material per kg of nominal HM"
            }
            input(44) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Added cost for fuel fabrication (normally zero, can be used to add burnable poisons, Th, other extra materials that have independent fuel cost distribution)"
            }
            input(45) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Cost of Conversion ($/kg_U product as UF6)"
            }
            input(46) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Cost of De-Conversion of depleted uranium hexafluoride ($/kgDU as DU3O8 product)"
            }
            input(47) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Cost of off-site wet storage ($/kg_HM)"
            }
            input(48) {
                low = 50
                nominal = 100
                high = 130
                distribution = 1
                description = "Cost of SNF conditioning before shipping ($/kg_HM)"
            }
            input(49) {
                low = 0.2
                nominal = 0.2
                high = 0.2
                distribution = 0
                description = "Fabrication loss for fresh uranium fuel (%) (100=100%)"
            }
            input(50) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Conversion loss for fresh uranium fuel (%) (100=100%)"
            }
            input(51) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Losses at the reprocessing plant that accepts fuel from previous island (%) (100=100%)"
            }
            input(52) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Fraction of the core loaded with natural/enriched uranium (1=100%)"
            }
            input(53) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Fraction of the core loaded with reprocessed material from the previous island (1=100%)"
            }
            input(75) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 1: Do nothing"
            }
            input(76) {
                low = 1.16
                nominal = 1.16
                high = 1.16
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 2: Geol. disposal"
            }
            input(77) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 3: Dry storage + Geol. disposal"
            }
            input(78) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 4: 1 mills/kWh"
            }
            input(79) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 5: Reprocessing within the island"
            }
            input(80) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Specific cost of SNF dry storage ($/kgHM)"
            }
            input(81) {
                low = 265
                nominal = 550
                high = 801
                distribution = 1
                description = "Specific cost of SNF geologic disposal ($/kgHM)"
            }
            input(87) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Lead time for dry-storage (y)"
            }
        }
    }
}
