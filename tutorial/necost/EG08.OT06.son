necost {
    % EG08/OT06 - Subcritical Thorium Blanket Driven by an ICF Neutron Source
    % Source: FCRD-FCO-2013-000196, Appendix A report input tables.
    % NE-COST input preparer: Edward Hoffman (ANL)
    % Technical Reviewer: Francesco Ganda (INL)
    % In fuel cycle option EG08/OT06 Subcritical Thorium Blanket Driven by an ICF Neutron Source, thorium fuel is irradiated in a blanket zone of a FFH. A continuous 500 MW of fusion power is available to start building up the inventory of fissile material in the blanket volumes and then continue driving the subcritical reactor. Over an approximately 2 year period the fission power goes from very small to the nominal power level of 1,500 MW of fission power. Following exposure the fuel assemblies are discharged and stored as waste. At nominal conditions, a total of 2,000 MWth power is produced and produces a gross output of 860 MWe. The fusion system consumes an average of 175 MWe and the balance of plant consumes an average of 20 MWe. This leaves an average net electrical generation of 665 MWe.
    % The case is modeled using a single NE-COST island. The effect of the 2-year build-up phase on the LCAE was neglected, since (1) the focus of the Screening and Evaluation is on systems operating in equilibrium conditions; (2) the exact profile of the ramp-up is not available; (3) the NE-COST code is set-up to treat equilibrium conditions, while this involves a transient; (4) the fuel resides in the core for 53.2 EFPY; therefore neglecting the build-up phase would at the most account for an under-estimation of the calculated LCAE by 4%: this has to be viewed in the context of a high uncertainty in the input cost parameter, especially the capital investment, for this low TRL option.
    % Report LCAE at 3% discount rate: mean 72.2 mills/kWh, std 8.8 mills/kWh.
    % Report LCAE at 5% discount rate: mean 95.1 mills/kWh, std 12.1 mills/kWh.
    % Report LCAE at 10% discount rate: mean 172.3 mills/kWh, std 24.6 mills/kWh.

    construction_interest_rate = 0.05
    operations_interest_rate = 0.05
    sample_size = 2000

    legacy_inputs {
        case(EG08) {
            % Report LCAE weight for this input table.
            energy_fraction = 1
            input(1) {
                low = 1.5e+09
                nominal = 1.5e+09
                high = 1.5e+09
                distribution = 0
                description = "Reference core thermal power (W)"
            }
            input(2) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Core thermal power as a fraction of reference (1=100%)"
            }
            input(3) {
                low = 44.33
                nominal = 44.33
                high = 44.33
                distribution = 0
                description = "Thermal efficiency (%) (100=100%)"
            }
            input(4) {
                low = 40
                nominal = 40
                high = 40
                distribution = 0
                description = "Direct specification of core HM mass (MTiHM)."
            }
            input(11) {
                low = 729
                nominal = 729
                high = 729
                distribution = 0
                description = "Average discharge burnup (GWD/MTiHM)"
            }
            input(13) {
                low = 4986
                nominal = 8915
                high = 12137
                distribution = 1
                description = "Overnight reactor capital cost ($/kWe)"
            }
            input(15) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 0
                description = "Discount rate (1=100%)"
            }
            input(16) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for front end costs (%/year) (1=100%)"
            }
            input(17) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for back end costs (%/year) (1=100%)"
            }
            input(18) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Escalation rate for reactor O & M costs (%/year) (1=100%)"
            }
            input(19) {
                low = 5
                nominal = 5
                high = 5
                distribution = 0
                description = "Years for reactor construction"
            }
            input(20) {
                low = 0.05
                nominal = 0.05
                high = 0.05
                distribution = 0
                description = "Annual interest rate during construction, compounded quarterly (1=100%)"
            }
            input(21) {
                low = 0.9
                nominal = 0.9
                high = 0.9
                distribution = 0
                description = "Direct specification of reactor capacity factor (1=100%)"
            }
            input(27) {
                low = 85
                nominal = 140
                high = 269
                distribution = 1
                description = "Direct specification of fixed O&M costs [$/kWe-y]"
            }
            input(28) {
                low = 4.6
                nominal = 9.1
                high = 12.4
                distribution = 1
                description = "O&M variable cost (mills/kWh)"
            }
            input(40) {
                low = 65
                nominal = 110
                high = 230
                distribution = 1
                description = "Cost of U3O8 ($/kgU as Uranium ore concentrate)"
            }
            input(41) {
                low = 0
                nominal = 0
                high = 0
                distribution = 2
                description = "Cost of SWU ($/kg_SWU)"
            }
            input(42) {
                low = 250
                nominal = 450
                high = 630
                distribution = 1
                description = "Cost of Fuel Fabrication ($/kg of enriched U)"
            }
            input(43) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Kg of extra fab material per kg of nominal HM"
            }
            input(44) {
                low = 45
                nominal = 75
                high = 155
                distribution = 0
                description = "Added cost for fuel fabrication (normally zero, can be used to add burnable poisons, Th, other extra materials that have independent fuel cost distribution)"
            }
            input(48) {
                low = 50
                nominal = 100
                high = 130
                distribution = 1
                description = "Cost of SNF conditioning before shipping ($/kg_HM)"
            }
            input(49) {
                low = 0.2
                nominal = 0.2
                high = 0.2
                distribution = 0
                description = "Fabrication loss for fresh uranium fuel (%) (100=100%)"
            }
            input(52) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "Fraction of the core loaded with natural thorium (1=100%)"
            }
            input(53) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Fraction of the core loaded with reprocessed material from the previous island (1=100%)"
            }
            input(75) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 1: Do nothing"
            }
            input(76) {
                low = 1
                nominal = 1
                high = 1
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 2: Geol. disposal"
            }
            input(77) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 3: Dry storage + Geol. disposal"
            }
            input(78) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 4: 1 mills/kWh"
            }
            input(79) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "(1=100%) Fraction of Back-end route - 5: Reprocessing within the island"
            }
            input(80) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Specific cost of SNF dry storage ($/kgHM)"
            }
            input(81) {
                low = 265
                nominal = 550
                high = 801
                distribution = 1
                description = "Specific cost of SNF geologic disposal ($/kgHM)"
            }
            input(87) {
                low = 0
                nominal = 0
                high = 0
                distribution = 0
                description = "Lead time for dry-storage (y)"
            }
        }
    }
}
