% ACCERT Test input file
% Author: J. Zhou (jia.zhou@anl.gov)
% Last updated: 04/17/2024
% Stellarator fusion cost model example based on UKAEA PROCESS:
% https://github.com/ukaea/PROCESS.

accert{
    ref_model = "stellarator"
    var("csi"){value = 16 unit = million} 
    var("lsa"){value = 2 unit = N/A}
    var("denstl"){value = 7800 unit = 'kg/m3'}
}
